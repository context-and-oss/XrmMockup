<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>XrmMockup.PermissionAnalyzer.Tool</RootNamespace>
    <AssemblyName>XrmMockup.PermissionAnalyzer.Tool</AssemblyName>
    <!-- The analysis allocates heavily while it holds whole compilations, as the compiler does -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Tool-specific settings -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>xrmmockup-permissions</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <PackageId>XrmMockup.PermissionAnalyzer</PackageId>
    <!-- Project-specific metadata (shared metadata comes from Directory.Build.props) -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/CHANGELOG.md'))</PackageReleaseNotes>
    <Description>CLI tool that works out which Dataverse privileges your code needs, by static analysis</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="XrmMockup.PermissionAnalyzer.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PermissionAnalyzer.Core\PermissionAnalyzer.Core.csproj" />
    <ProjectReference Include="..\..\ToolsCommon\ToolsCommon.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <!-- Only for the SecurityRole types the metadata files are serialized with -->
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.10" />
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lift transitive packages with known vulnerabilities (from Dataverse.Client) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <!-- Icon is included by Directory.Build.props, license via PackageLicenseExpression -->
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
  <Import Project="..\..\MetadataSkeleton\MetadataSkeleton.projitems" Label="Shared" />
</Project>
