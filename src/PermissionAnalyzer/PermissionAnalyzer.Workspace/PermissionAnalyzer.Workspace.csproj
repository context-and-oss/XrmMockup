<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>XrmMockup.PermissionAnalyzer.Workspace</AssemblyName>
    <!-- Internal assembly, shipped by the owning products rather than independently released. -->
    <IsPackable>false</IsPackable>
    <Description>Opt-in MSBuild and Roslyn source loading for XrmMockup static permission checks.</Description>
    <!-- Produce a library-only runtime payload for Core's opt-in SDK, not a CLI/tool executable. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup><InternalsVisibleTo Include="XrmMockup.PermissionAnalyzer.Tool" /><InternalsVisibleTo Include="XrmMockup.PermissionAnalyzer.Tests" /></ItemGroup>
  <ItemGroup><ProjectReference Include="..\PermissionAnalyzer.Core\PermissionAnalyzer.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <!-- Align scripting from Core's workflow package with the opt-in workspace Roslyn version. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <!-- SDK metadata types used by the private wire contracts -->
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.10" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lift transitive packages with known vulnerabilities (from Dataverse.Client) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>
</Project>
