<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>XrmMockup.MetadataGenerator.Tool</RootNamespace>
    <AssemblyName>XrmMockup.MetadataGenerator.Tool</AssemblyName>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Tool-specific settings -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>xrmmockup-metadata</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <PackageId>XrmMockup.MetadataGenerator</PackageId>
    <!-- Project-specific metadata (shared metadata comes from Directory.Build.props) -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Development build. See CHANGELOG.md for release history.</PackageReleaseNotes>
    <PackageReleaseNotes Condition="'$(MetadataReleaseNotesPath)' != ''">$([System.IO.File]::ReadAllText('$(MetadataReleaseNotesPath)'))</PackageReleaseNotes>
    <Description>CLI tool for generating XrmMockup metadata from Dataverse</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MetadataGenerator.Core\MetadataGenerator.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Icon is included by Directory.Build.props, license via PackageLicenseExpression -->
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.example.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>